      if (isInitialized) return;
      await Tone.start();
      
      const actx = Tone.context.rawContext;
      source = actx.createMediaElementSource(audio);
      
      // ØªØ¬Ù‡ÙŠØ² Ø§Ù„ÙÙ„Ø§ØªØ±
      pitchShift = new Tone.PitchShift(0);
      gainNode = new Tone.Volume(0);
      echoNode = new Tone.FeedbackDelay("8n", 0.4);
      reverbNode = new Tone.Reverb(2.5);
      
      // Ø§Ù„Ø¥Ø¹Ø¯Ø§Ø¯Ø§Øª Ø§Ù„Ø§ÙØªØ±Ø§Ø¶ÙŠØ© Ù„Ù„ÙÙ„Ø§ØªØ± (Ø­Ø³Ø¨ Ø§Ù„ØªÙˆØ¬Ù„Ø²)
      echoNode.wet.value = echoToggle.classList.contains('active') ? 1 : 0;
      reverbNode.wet.value = reverbToggle.classList.contains('active') ? 1 : 0;
      
      // Ø§Ù„Ø³Ù„Ø³Ù„Ø© Ø§Ù„ØµÙˆØªÙŠØ©
      Tone.connect(source, pitchShift);
      Tone.connect(pitchShift, gainNode);
      Tone.connect(gainNode, echoNode);
      Tone.connect(echoNode, reverbNode);
      Tone.connect(reverbNode, Tone.getDestination());
      
      isInitialized = true;
    }

    playBtn.addEventListener('click', async () => {
      if (!audio.src) return;
      await initAudioGraph();
      
      if (Tone.context.state !== 'running') {
        await Tone.context.resume();
      }
      
      if (audio.paused) {
        audio.play();
        playBtn.innerText = 'â¸';
      } else {
        audio.pause();
        playBtn.innerText = 'â–¶';
      }
    });

    // Pitch
    pitchSlider.addEventListener('input', (e) => {
      if(pitchShift) pitchShift.pitch = parseFloat(e.target.value);
    });

    // Tempo
    tempoSlider.addEventListener('input', (e) => {
      audio.playbackRate = parseFloat(e.target.value);
    });

    // Amp
    ampSlider.addEventListener('input', (e) => {
      if(gainNode && ampToggle.classList.contains('active')) {
        gainNode.volume.value = (parseFloat(e.target.value) - 1) * 8; 
      }
    });

    // Toggles Events
    ampToggle.addEventListener('click', function() {
      this.classList.toggle('active');
      if (gainNode) gainNode.volume.value = this.classList.contains('active') ? (ampSlider.value - 1) * 8 : 0;
    });

    echoToggle.addEventListener('click', function() {
      this.classList.toggle('active');
      if (echoNode) echoNode.wet.value = this.classList.contains('active') ? 1 : 0;
    });

    reverbToggle.addEventListener('click', function() {
      this.classList.toggle('active');
      if (reverbNode) reverbNode.wet.value = this.classList.contains('active') ? 1 : 0;
    });

    // A/B Loop Events
    btnA.addEventListener('click', () => { 
      loopA = audio.currentTime; 
      btnA.style.background = '#8ab4f8'; 
    });
    
    btnB.addEventListener('click', () => { 
      if(loopA !== null) { 
        loopB = audio.currentTime; 
        btnB.style.background = '#8ab4f8'; 
      }
    });
    
    btnClearAB.addEventListener('click', () => { 
      loopA = null; loopB = null; 
      btnA.style.background = '#ccc'; 
      btnB.style.background = '#ccc'; 
    });

    // Time Tracking & Loop Logic
    audio.addEventListener('timeupdate', () => {
      if (audio.duration) {
        seekSlider.value = (audio.currentTime / audio.duration) * 100;
        currentTimeEl.innerText = formatTime(audio.currentTime);
        durationEl.innerText = formatTime(audio.duration);
        
        if (loopA !== null && loopB !== null && audio.currentTime >= loopB) {
          audio.currentTime = loopA;
        }
      }
    });

    seekSlider.addEventListener('input', (e) => {
      if (audio.duration) {
        audio.currentTime = (e.target.value / 100) * audio.duration;
      }
    });

    function resetSlider(id) {
      const slider = document.getElementById(id);
      if(id === 'pitch') { slider.value = 0; if(pitchShift) pitchShift.pitch = 0; }
      if(id === 'tempo') { slider.value = 1; audio.playbackRate = 1; }
      if(id === 'amp') { slider.value = 2.5; if(gainNode && ampToggle.classList.contains('active')) gainNode.volume.value = 12; }
    }