<title>Music Player</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
<style>
  * { box-sizing: border-box; font-family: sans-serif; }
  body { 
    background-color: #0b0b0f; 
    color: #e0e0e0; 
    margin: 0; 
    padding: 15px; 
    user-select: none; 
    height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  .header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 15px; border-bottom: 1px solid #1a1a1a; margin-bottom: 20px;}
  .header-title { font-size: 13px; color: #aaa; }
  
  .control-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 25px; }
  .label { font-size: 14px; width: 25%; text-align: right; }
  
  .slider-wrapper { display: flex; align-items: center; flex: 1; margin: 0 10px; justify-content: center; }
  .slider-wrapper span { font-size: 18px; margin: 0 10px; color: #aaa; }
  input[type=range] { 
    width: 100%; accent-color: #8ab4f8; background: #333; height: 4px; border-radius: 2px; outline: none; -webkit-appearance: none;
  }
  input[type=range]::-webkit-slider-thumb { 
    -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%; background: #8ab4f8; cursor: pointer;
  }
  
  .actions { display: flex; align-items: center; gap: 15px; width: 20%; justify-content: flex-end; }
  .icon { background: none; border: none; color: #888; font-size: 18px; cursor: pointer; padding: 0; }
  
  .toggle { 
    width: 36px; height: 20px; background: #444; border-radius: 10px; position: relative; display: inline-block; cursor: pointer;
  }
  .toggle.active { background: #8ab4f8; }
  .toggle::after { 
    content: ''; position: absolute; width: 14px; height: 14px; background: #ccc; border-radius: 50%; top: 3px; right: 3px; transition: 0.2s; 
  }
  .toggle.active::after { right: 19px; background: #000; }

  .ab-group { display: flex; gap: 10px; justify-content: center; flex: 1; }
  .ab-btn { background: #ccc; color: #000; border: none; padding: 4px 12px; border-radius: 4px; font-weight: bold; font-size: 12px; cursor: pointer; transition: 0.2s;}
  
  .visualizer { height: 30px; border-bottom: 2px dotted #555; margin: 30px 0; width: 100%; }

  .playback-section { margin-top: auto; padding-bottom: 20px; }
  .progress { display: flex; align-items: center; gap: 10px; margin-bottom: 25px; }
  .time { font-size: 11px; color: #aaa; min-width: 35px; text-align: center; }
  
  .main-controls { display: flex; align-items: center; justify-content: space-between; padding: 0 10px; }
  .play-btn { 
    background: #1a4f8b; color: #8ab4f8; border: none; width: 65px; height: 45px; border-radius: 15px; font-size: 22px; display: flex; align-items: center; justify-content: center; cursor: pointer;
  }
  
  .song-name { text-align: center; font-size: 13px; color: #8ab4f8; margin-top: 25px; }
  #fileInput { display: none; }
</style>
</head>
